-- When each feed was last fetched (epoch ms), by a show page or the background refresh, so opening the show soon
-- after doesn't fetch it again; local only.
CREATE TABLE feed_fetch (
    feed_url TEXT NOT NULL PRIMARY KEY,
    fetched_at INTEGER NOT NULL
);

fetchedAt:
SELECT fetched_at FROM feed_fetch WHERE feed_url = ?;

put:
INSERT OR REPLACE INTO feed_fetch(feed_url, fetched_at) VALUES (?, ?);
