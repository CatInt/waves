-- Podcasts known locally. Rows with subscribed = 0 and a non-null subscriptionUpdatedAt are sync tombstones.
CREATE TABLE podcast (
    feedUrl TEXT NOT NULL PRIMARY KEY,
    title TEXT NOT NULL,
    author TEXT,
    description TEXT,
    artworkUrl TEXT,
    appleId INTEGER,
    subscribed INTEGER NOT NULL DEFAULT 0,
    subscriptionUpdatedAt INTEGER
);

CREATE INDEX podcast_subscribed_title ON podcast(subscribed, title);

upsert:
INSERT OR REPLACE INTO podcast(feedUrl, title, author, description, artworkUrl, appleId, subscribed, subscriptionUpdatedAt)
VALUES (?, ?, ?, ?, ?, ?, ?, ?);

insertUnsubscribedIfAbsent:
INSERT OR IGNORE INTO podcast(feedUrl, title, author, description, artworkUrl, appleId, subscribed, subscriptionUpdatedAt)
VALUES (?, ?, ?, ?, ?, ?, 0, NULL);

updateMetadata:
UPDATE podcast
SET title = :title, author = :author, description = :description, artworkUrl = :artworkUrl,
    appleId = COALESCE(:appleId, appleId)
WHERE feedUrl = :feedUrl;

markUnsubscribed:
UPDATE podcast SET subscribed = 0, subscriptionUpdatedAt = :updatedAt WHERE feedUrl = :feedUrl;

subscribed:
SELECT * FROM podcast WHERE subscribed = 1 ORDER BY title COLLATE NOCASE, feedUrl;

subscriptionRecords:
SELECT * FROM podcast WHERE subscriptionUpdatedAt IS NOT NULL ORDER BY feedUrl;

byFeedUrl:
SELECT * FROM podcast WHERE feedUrl = ?;

deleteAll:
DELETE FROM podcast;
