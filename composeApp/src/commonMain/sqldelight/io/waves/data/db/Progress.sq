CREATE TABLE progress (
    feedUrl TEXT NOT NULL,
    guid TEXT NOT NULL,
    positionMs INTEGER NOT NULL,
    durationMs INTEGER NOT NULL,
    completed INTEGER NOT NULL DEFAULT 0,
    updatedAt INTEGER NOT NULL,
    PRIMARY KEY (feedUrl, guid)
);

-- Callers enforce last-writer-wins via storedUpdatedAt inside a transaction.
put:
INSERT OR REPLACE INTO progress(feedUrl, guid, positionMs, durationMs, completed, updatedAt)
VALUES (?, ?, ?, ?, ?, ?);

storedUpdatedAt:
SELECT updatedAt FROM progress WHERE feedUrl = ? AND guid = ?;

byId:
SELECT * FROM progress WHERE feedUrl = ? AND guid = ?;

all:
SELECT * FROM progress ORDER BY updatedAt DESC;

deleteAll:
DELETE FROM progress;
