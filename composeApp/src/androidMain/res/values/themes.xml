<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
    The window behind the app while it starts, in the app's own background colour (light here, dark in values-night),
    so opening it goes from the system splash straight into the app without a flash of another colour.
    -->
    <style name="Theme.Waves" parent="@android:style/Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/waves_background</item>
        <item name="android:windowSplashScreenBackground" tools:targetApi="31">@color/waves_background</item>
    </style>
</resources>
